# Copie para .env e preencha com valores reais (o .env não é versionado).

# URL JDBC do Postgres (Supabase ou o container local do docker-compose)
DB_URL=jdbc:postgresql://localhost:5432/economize
# Usuário do banco
DB_USER=economize
# Senha do banco
DB_PASSWORD=troque-esta-senha

# Segredo de assinatura dos JWTs (mínimo 32 caracteres; gere um valor aleatório)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres

# Chave da API do Google Gemini (assistente IA) — https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-gemini

# Token da brapi.dev (cotações de ações/índices) — https://brapi.dev/dashboard
BRAPI_TOKEN=seu-token-brapi

# Origens liberadas no CORS, separadas por vírgula
# (default já cobre o dev local do Expo: Metro em 8081 e web em 19006)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# RabbitMQ — usado apenas com o profile "rabbit" ativo (defaults batem com o docker-compose)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=economize
RABBITMQ_PASSWORD=economize

# IA na categorização de extratos (bônus, opcional): sugere categoria só para o
# que regras e keywords não resolveram; nada é confirmado sem o usuário.
# Governa o uso da CHAVE DO SERVIDOR; quem cadastrar chave própria (abaixo)
# recebe a sugestão de qualquer forma, porque nesse caso quem paga é ele
AI_CATEGORIZATION_ENABLED=false

# --- EC-107: chave própria de IA (BYOK) ---
# Chave-mestra que cifra, no banco, a chave que cada usuário cadastra.
# 32 bytes em Base64:  openssl rand -base64 32
# Deixe VAZIA para não oferecer a opção: a API sobe igual, /api/v1/ai/providers
# devolve byokAvailable=false e todo mundo segue na chave do servidor.
# ATENÇÃO: perder ou trocar esta chave torna ILEGÍVEIS as chaves já cadastradas.
# Isso não corrompe nada em silêncio — a API passa a responder keyStatus=UNREADABLE
# e pede o recadastro —, mas os usuários terão de cadastrar de novo.
SECRET_ENCRYPTION_KEY=
# Nome da chave ativa; fica gravado junto de cada segredo para permitir rotação
SECRET_ENCRYPTION_KEY_ID=k1
# Chaves antigas, só para leitura durante uma rotação: id:base64,id:base64
SECRET_ENCRYPTION_PREVIOUS_KEYS=
# Rótulo do provedor que a CHAVE DO SERVIDOR atende — é o que o app mostra para
# quem não cadastrou chave própria. Só rotulagem: quem manda no caminho do
# servidor é GEMINI_API_KEY acima. Valor fora de
# GEMINI|OPENAI|ANTHROPIC|OPENROUTER derruba o boot, de propósito: um "gemeni"
# digitado aqui viraria um provider que o app não sabe interpretar.
AI_SERVER_PROVIDER=GEMINI

# Conector Open Finance via Meu Pluggy (opcional — ADR-011).
# ATENÇÃO: são DOIS sites diferentes, e as credenciais NÃO ficam no meu.pluggy.ai.
# 1. https://meu.pluggy.ai — crie a conta e conecte seus bancos. Nada a copiar aqui.
# 2. https://dashboard.pluggy.ai — crie a conta e uma aplicação de desenvolvimento.
#    A tela da aplicação mostra o Client ID e o Client Secret.
# 3. Ainda na aplicação, "Ir para Demo" > escolha o conector Meu Pluggy > entre com
#    a conta do passo 1 e autorize. Isso cria o item.
# 4. No menu de três pontos do Demo, "Copiar Item ID" — esse é o PLUGGY_ITEM_IDS
#    (vários itens vão separados por vírgula).
# 5. Ligue a flag e rode POST /api/v1/connectors/pluggy/sync
# O conector Meu Pluggy só aparece na lista enquanto o período de teste da conta
# do dashboard estiver ativo: crie o item antes de ele expirar. Depois disso a
# conexão continua funcionando, mas a lista de conectores não é mais editável.
# As credenciais são de UMA pessoa: PLUGGY_OWNER_EMAIL diz de quem, e só essa
# conta consegue sincronizar (sem isso o extrato dela iria parar em qualquer outra)
PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
PLUGGY_OWNER_EMAIL=
